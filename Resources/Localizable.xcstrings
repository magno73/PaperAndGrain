{
  "sourceLanguage": "en",
  "strings": {
    " – Print": {
      "comment": "Suffix of the print folder name, after the book title; keep the leading space and dash.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " – Print"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " – Stampa"
          }
        }
      }
    },
    "%1$@: the printer’s table stops at %2$lld pages. Enter the value from the quote": {
      "comment": "Preflight blocker; the first argument is a measure such as Spine width.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: the printer’s table stops at %2$lld pages. Enter the value from the quote"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: la tabella dello stampatore arriva a %2$lld pagine. Inserisci il valore dal preventivo"
          }
        }
      }
    },
    "%1$lld of %2$lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld di %2$lld"
          }
        }
      }
    },
