    "%@ can’t be opened: its manifest.json file is damaged or does not describe a book.": {
      "comment": "The argument is the quoted package name, or error.damaged_book.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can’t be opened: its manifest.json file is damaged or does not describe a book."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire %@: il file manifest.json è danneggiato o non descrive un libro."
          }
        }
      }
    },
    "%@ from the quote": {
      "comment": "Field label; the argument is a measure such as Spine width.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ from the quote"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dal preventivo"
          }
        }
      }
    },
    "%@ is in a read-only location. Changes will not be saved until you use Save As to copy it somewhere else.": {
      "comment": "The argument is the quoted book title, or “This book”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is in a read-only location. Changes will not be saved until you use Save As to copy it somewhere else."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si trova in una posizione in sola lettura. Le modifiche non verranno salvate finché non usi Salva con nome per copiarlo altrove."
          }
        }
      }
    },
    "%@ missing: enter it from the printer’s quote": {
      "comment": "Preflight blocker; the argument is a measure such as Spine width.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ missing: enter it from the printer’s quote"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valore mancante, %@: inseriscilo dal preventivo dello stampatore"
          }
        }
      }
    },
    "%@ was moved, renamed or is no longer available. Use Save As to keep your changes in another place.": {
      "comment": "The argument is the quoted book title, or “The book”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was moved, renamed or is no longer available. Use Save As to keep your changes in another place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato spostato, rinominato o non è più disponibile. Usa Salva con nome per conservare le modifiche in un’altra posizione."
          }
        }
      }
    },
    "%@ was saved by a newer version of Paper & Grain. It is open read-only and changes will not be saved. Update the app to edit it.": {
      "comment": "The argument is the quoted book title, or “This book”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was saved by a newer version of Paper & Grain. It is open read-only and changes will not be saved. Update the app to edit it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato salvato con una versione più recente di Paper & Grain. È aperto in sola lettura: le modifiche non verranno salvate. Aggiorna l’app per modificarlo."
          }
        }
      }
    },
